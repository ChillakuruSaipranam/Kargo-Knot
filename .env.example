# Copy to .env and fill in before running docker compose up

# Docker network your SQL Server container is on (from Connected Networks in Docker).
# Your SQL container is on: bridge + contactmanager — use contactmanager here.
SQLSERVER_NETWORK=contactmanager

# Docker container name (from `docker ps` NAMES column — NOT the Tailscale hostname yashpc).
# Example: if `docker ps` shows "sqlserver" or "contactmanager-db-1", use that exact name.
SQLSERVER_HOST=sql-server

# SQL Server SA password (matches MSSQL_SA_PASSWORD on your container)
SQLSERVER_PASSWORD=yash@123

# JWT signing key (min 32 characters)
JWT_KEY=TruckTransport_SuperSecret_Key_Change_In_Production_2026!

# Tailscale MagicDNS hostname — browser/CORS only, not for SQL
PUBLIC_URL=http://yashpc

# Host port for Kargo Knot nginx (portfolio uses 80)
WEB_PORT=8082

# Angular base href — must match nginx subpath
BASE_HREF=/kargoknot/
