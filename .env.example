# Copy to .env on the server (one-time setup):
#   cp .env.example .env
#   nano .env
#
# Find your SQL container name:
#   docker ps --format "table {{.Names}}\t{{.Image}}" | grep mssql

# Docker network your SQL Server container is on
SQLSERVER_NETWORK=contactmanager

# Full connection string — replace YOUR_SQL_CONTAINER with the name from docker ps
ConnectionStrings__DefaultConnection=Server=sql-server,1433;Database=TruckTransportDb;User ID=sa;Password=yash@123;TrustServerCertificate=True;MultipleActiveResultSets=True

# JWT signing key (min 32 characters)
Jwt__Key=TruckTransport_SuperSecret_Key_Change_In_Production_2026!

# Tailscale hostname — browser/CORS only
Cors__Origins__0=http://yashpc

# Host port for Kargo Knot nginx (portfolio uses 80)
WEB_PORT=8082

# Angular base href
BASE_HREF=/kargoknot/
