FROM node:20-alpine AS build
WORKDIR /app

COPY truck-transport-frontend/package.json truck-transport-frontend/package-lock.json ./
RUN npm ci

COPY truck-transport-frontend/ .

ARG BASE_HREF=/kargoknot/
RUN npm run build -- --configuration production --base-href=${BASE_HREF}

FROM nginx:1.27-alpine
COPY docker/nginx/default.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist/truck-transport-frontend/browser /usr/share/nginx/html/kargoknot
EXPOSE 80
